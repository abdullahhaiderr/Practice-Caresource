# Environment variables for PracticeCareSource
# Copy to .env.local for development. Set the same values in Vercel.

# Public canonical origin used by metadata, sitemap, robots, and JSON-LD.
# Use the final primary domain with no trailing slash. Confirm non-www vs www.
NEXT_PUBLIC_SITE_URL=https://practicecaresource.com

# Optional email delivery through Resend.
# If these are unset, the contact API validates submissions and logs them to
# the server console instead of sending email. Configure before launch.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=inquiries@practicecaresource.com
# CONTACT_FROM_EMAIL=PracticeCareSource <website@practicecaresource.com>
